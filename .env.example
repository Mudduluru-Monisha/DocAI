# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Models. Google retires model names, so if you see a "404 NOT_FOUND ... model" error, change these
# (or edit them live in the app sidebar under "Models").
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.5-flash-lite

# Free-tier pacing: requests per minute allowed for your key (Flash-Lite free tier is about 10).
GEMINI_RPM=8

# Optional
# MAX_ANALYSIS_CALLS=60
# DOCUMIND_DATA_DIR=./data
